<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="center"
    android:orientation="vertical">

    <com.line.demo.yu.segment.DragLayout
        android:id="@+id/drag_layout"
        android:layout_width="200dp"
        android:layout_height="wrap_content">

        <com.line.demo.yu.segment.MattingBgImageView
            android:id="@+id/iv_renwu_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_40"
            android:adjustViewBounds="true"
            android:src="@drawable/renwu"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.line.demo.yu.segment.SegmentImageView
            android:id="@+id/iv_renwu_amin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_40"
            android:adjustViewBounds="true"
            android:src="@drawable/renwu"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.line.demo.yu.segment.DragLayout>

    <com.line.demo.yu.segment.RenwuImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_40"
        android:adjustViewBounds="true"
        android:src="@drawable/renwu" />


</androidx.appcompat.widget.LinearLayoutCompat>
