<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_add"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cmm_dp_10"
        android:background="#4D34785F"
        android:gravity="center"
        android:padding="10dp"
        android:text="add"
        android:textColor="#111111"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_remove"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cmm_dp_10"
        android:background="#4D34785F"
        android:gravity="center"
        android:padding="10dp"
        android:text="remove"
        android:textColor="#111111"
        app:layout_constraintLeft_toRightOf="@id/tv_add"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cmm_dp_10"
        android:background="#4D345678"
        android:orientation="vertical"
        android:textColor="#111111"
        app:layout_constraintBottom_toTopOf="@id/text_2"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/text"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="@dimen/cmm_dp_10"
            android:background="#4D34785F"
            android:gravity="center"
            android:padding="10dp"
            android:text="text_1"
            android:textColor="#111111"
            app:layout_constraintBottom_toTopOf="@id/text_3"
            app:layout_constraintLeft_toLeftOf="parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="@dimen/cmm_dp_10"
        android:background="#4D34785F"
        android:padding="10dp"
        android:textColor="#111111"
        app:layout_constraintBottom_toTopOf="@id/text_3"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/text_3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="@dimen/cmm_dp_10"
        android:background="#4D787734"
        android:padding="10dp"
        android:textColor="#111111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>